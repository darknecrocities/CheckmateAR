{
  "expo": {
    "name": "CheckmateAR",
    "slug": "checkmatear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow CheckmateAR to access your camera to detect physical chessboards and project AR moves."
      }
    },
    "android": {
      "package": "com.darknecrocities.checkmatear",
      "permissions": ["android.permission.CAMERA"]
    },
    "androidStatusBar": {
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CheckmateAR to access your camera to detect physical chessboards and project AR moves."
        }
      ]
    ]
  }
}
